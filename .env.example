# Set these in Vercel → Project → Settings → Environment Variables, then redeploy.
# Leave them empty and the site builds exactly as before: no ads, no cookie
# banner, no ads.txt.

# AdSense publisher ID from the AdSense dashboard.
VITE_ADSENSE_CLIENT=ca-pub-0000000000000000

# Ad unit IDs (AdSense → Ads → By ad unit). Numeric, e.g. 1234567890.
VITE_ADSENSE_SLOT_ARTICLE=
VITE_ADSENSE_SLOT_FOOTER=

# Token from Search Console → Verify ownership → HTML tag (content="…").
VITE_GOOGLE_SITE_VERIFICATION=
